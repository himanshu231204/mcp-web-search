# Application Settings
APP_NAME=MCP Web Search Server
VERSION=1.0.0
HOST=0.0.0.0
PORT=10000

# Search Settings
DEFAULT_NUM_RESULTS=5
MAX_NUM_RESULTS=20
SEARCH_TIMEOUT=10

# Fetch Settings
FETCH_TIMEOUT=10
MAX_CONTENT_LENGTH=5000
MAX_REDIRECTS=5

# SSRF Protection
# Leave false unless the deployment is trusted and intentionally scrapes an
# internal network. When false, fetch_page refuses hosts that resolve to
# loopback, private, link-local, or otherwise non-public addresses.
ALLOW_PRIVATE_NETWORK_FETCH=false

# Rate Limiting
RATE_LIMIT_PER_MINUTE=20

# Cache Settings
CACHE_SIZE=100